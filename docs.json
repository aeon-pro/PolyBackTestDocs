{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PolyBackTest",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "pages": [
          "index",
          "api-keys"
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Dashboard",
          "href": "https://polybacktest.com/dashboard",
          "icon": "gauge"
        },
        {
          "anchor": "Website",
          "href": "https://polybacktest.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@polybacktest.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://polybacktest.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}